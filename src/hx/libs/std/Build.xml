<xml>

<pragma once="true" />

<files id="hxcpp_std" dir="${this_dir}" >
  <options name="Options.txt" ifExists="Options.txt"/>
  <depend files="hxcpp-depends"/>
  <depend name="${this_dir}/Build.xml" dateOnly="true" />
  <cache value="1" asLibrary="true" />
  <!-- hxcpp_ssl, linked after this, calls Socket.cpp's _hx_std_socket_handle,
       which GNU ld does not go back for -->
  <addTwice value="1" />

  <file name="File.cpp"/>
  <file name="Sys.cpp"/>
  <file name="Process.cpp"/>
  <file name="Random.cpp"/>
  <file name="Socket.cpp" />

</files>


<target id="haxe">
  <files id="hxcpp_std"/>
  <lib name="ws2_32.lib" if="windows" unless="static_link" />
</target>


</xml>
