<xml>
 <include name="${HXCPP}/toolchain/haxe-target.xml"/>
 <files id="nekoconsts">
  <depend files="hxcpp-depends"/>
  <!-- The neko glue, which the files above leave out -->
  <depend name="${HXCPP}/include/hx/CFFILoader.h"/>
  <depend name="${HXCPP}/include/hx/CFFINekoLoader.h"/>
  <depend name="${HXCPP}/include/hx/NekoFunc.h"/>
  <file name="Bridge.cpp"/>
 </files>
 <!-- For the neko that loads it, which BuildNative asks for its architecture -->
 <target id="default" output="nekoconsts" tool="linker" toolid="${STD_MODULE_LINK}">
  <ext value=".ndll"/>
  <outdir name="ndll"/>
  <files id="nekoconsts"/>
 </target>
</xml>
