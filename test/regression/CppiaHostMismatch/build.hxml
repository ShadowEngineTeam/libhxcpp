-cp host
--main Main
-cpp bin
-D scriptable
-D dll_export=bin/host.info
-D HXCPP_CATCH_SEGV
--dce no
--next
-cp stale
--main ArgCount
-D dll_import=bin/host.info
# Haxe 5.0.0-preview.1 stops on haxe.macro.Error, which DCE leaves without its
# constructor, when the host's classes include haxe.Exception
# (HaxeFoundation/haxe#12208, fixed after preview.1)
--macro addGlobalMetadata('haxe.macro.Expr.Error', '@:keep')
-cppia bin/argcount.cppia
--next
-cp host
--main NativeThrow
-D dll_import=bin/host.info
--macro addGlobalMetadata('haxe.macro.Expr.Error', '@:keep')
-cppia bin/nativethrow.cppia
--next
-cp host
--main NullField
-D dll_import=bin/host.info
--macro addGlobalMetadata('haxe.macro.Expr.Error', '@:keep')
-cppia bin/nullfield.cppia
