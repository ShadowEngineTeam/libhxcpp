<xml>

<!-- LINUX TOOLS -->

<!-- The BSDs ship clang, not gcc -->
<set name="CXX" value="c++" if="bsd" unless="CXX" />


<section if="xcompile" >
   <section if="HXCPP_M64">
      <set name="CXX" value="${HXCPP_XLINUX64_CXX}" />
      <set name="HXCPP_STRIP" value="${HXCPP_XLINUX64_STRIP}" />
      <set name="HXCPP_AR" value="${HXCPP_XLINUX64_AR}" />
      <set name="HXCPP_RANLIB" value="${HXCPP_XLINUX64_RANLIB}" />
   </section>
   <section unless="HXCPP_M64">
      <set name="CXX" value="${HXCPP_XLINUX32_CXX}" />
      <set name="HXCPP_STRIP" value="${HXCPP_XLINUX32_STRIP}" />
      <set name="HXCPP_AR" value="${HXCPP_XLINUX32_AR}" />
      <set name="HXCPP_RANLIB" value="${HXCPP_XLINUX32_RANLIB}" />
   </section>
</section>

<include name="toolchain/gcc-toolchain.xml"/>
<set name="noM32" value="1" if="HXCPP_NO_M32" />
<set name="noM32" value="1" if="HXCPP_M64" />
<set name="noM32" value="1" if="rpi" />
<set name="noM32" value="1" if="HXCPP_ARM64 || HXCPP_ARMV7" />
<set name="noM64" value="1" if="HXCPP_ARM64 || HXCPP_ARMV7" />
<unset name="HXCPP_M64" if="noM64" />

<compiler id="linux" exe="g++" if="linux">
  <exe name="${CXX}" if="CXX" />
  <flag value="-c"/>
  <flag value="-flto" if="HXCPP_OPTIMIZE_LINK" unless="debug || HXCPP_LTO_THIN"/>
  <flag value="-flto=thin" if="HXCPP_LTO_THIN" unless="debug"/>
  <flag value="-fvisibility=hidden"/>
  <cppflag value="-frtti"/>
  <flag value="-g" if="HXCPP_DEBUG_LINK"/>
  <flag value="-O2" unless="debug"/>
  <flag value="-fpic"/>
  <flag value="-fPIC"/>
  <flag value="-Wno-overflow" />
  <cppflag value="-Wno-invalid-offsetof" />
  <flag value="-fsanitize=${HXCPP_SANITIZE}" if="HXCPP_SANITIZE"/>
  <flag value="-fno-omit-frame-pointer" if="HXCPP_SANITIZE"/>
  <flag value="-DHX_LINUX"/>
  <flag value="-DHXCPP_BIG_ENDIAN" if="HXCPP_BIG_ENDIAN"/>
  <include name="toolchain/common-defines.xml" />
  <flag value="-m32" unless="noM32"/>
  <flag value="-m64" if="HXCPP_M64" unless="noM64" />
  <flag value="-march=x86-64-v3" if="HXCPP_M64" unless="HXCPP_ARM64 || HXCPP_ARMV7 || HXCPP_NO_ARCH_LEVEL" />
  <flag value="-march=haswell" unless="HXCPP_M64 || HXCPP_ARM64 || HXCPP_ARMV7 || HXCPP_NO_ARCH_LEVEL" />
  <flag value="-march=armv7-a" if="HXCPP_ARMV7" unless="HXCPP_NO_ARCH_LEVEL" />
  <flag value="-mfpu=neon-vfpv4" if="HXCPP_ARMV7" unless="HXCPP_NO_ARCH_LEVEL" />
  <flag value="-march=armv8-a" if="HXCPP_ARM64" unless="HXCPP_NO_ARCH_LEVEL" />
  <flag value="-I${HXCPP}/include"/>
  <objdir value="obj/linux${OBJEXT}/"/>
  <outflag value="-o"/>
  <ext value=".o"/>
</compiler>

<linker id="dll" exe="g++" if="linux">
  <flag value="-flto" if="HXCPP_OPTIMIZE_LINK" unless="debug || HXCPP_LTO_THIN"/>
  <flag value="-flto=thin" if="HXCPP_LTO_THIN" unless="debug"/>
  <flag value="-fuse-ld=${HXCPP_USE_LD}" if="HXCPP_USE_LD"/>
  <exe name="${CXX}" if="CXX" />
  <fromfile value="" if="GCC_OLD" />
  <flag value="-shared"/>
  <flag value="-fpic"/>
  <flag value="-fPIC"/>
  <flag value="-m32" unless="noM32"/>
  <flag value="-m64" if="HXCPP_M64" unless="noM64" />
  <flag value="-Xlinker"/>
  <flag value="--no-undefined" unless="HXCPP_ALLOW_UNDEFINED" />
  <flag value="-debug" if="HXCPP_DEBUG_LINK" />
  <flag value="-fsanitize=${HXCPP_SANITIZE}" if="HXCPP_SANITIZE"/>
  <lib name="-ldl" unless="bsd"/>
  <ext value=".dso"/>
  <outflag value="-o "/>
</linker>

<linker id="exe" exe="g++" if="linux">
  <flag value="-flto" if="HXCPP_OPTIMIZE_LINK" unless="debug || HXCPP_LTO_THIN"/>
  <flag value="-flto=thin" if="HXCPP_LTO_THIN" unless="debug"/>
  <flag value="-fuse-ld=${HXCPP_USE_LD}" if="HXCPP_USE_LD"/>
  <exe name="${CXX}" if="CXX" />
  <fromfile value="" if="GCC_OLD" />
  <flag value="-debug" if="HXCPP_DEBUG_LINK" />
  <flag value="-rdynamic"/>
  <flag value="-fsanitize=${HXCPP_SANITIZE}" if="HXCPP_SANITIZE"/>
  <flag value="-m32" unless="noM32"/>
  <flag value="-m64" if="HXCPP_M64" unless="noM64" />
  <flag value="-Wl,-rpath=$ORIGIN" />
  <lib name="-ldl" unless="bsd"/>
  <ext value=""/>
  <outflag value="-o "/>
</linker>

</xml>
